# TeaMall 后端本地开发环境变量示例
# 复制为 .env 后按本机环境修改：Copy-Item .env.example .env
# Docker 部署时不使用本文件：后端环境变量由根目录 .env + docker-compose.yml 注入。
#
# 变量说明格式：作用（是否必填，默认值 / 示例值）

# 数据库连接串（必填；本地开发 host 用 localhost/127.0.0.1，Docker 内用服务名 mysql）
# 示例：mysql+pymysql://tea_mall:CHANGE_ME_DB_PASSWORD@localhost:3306/tea_mall?charset=utf8mb4
DATABASE_URL=mysql+pymysql://tea_mall:CHANGE_ME_DB_PASSWORD@localhost:3306/tea_mall?charset=utf8mb4
# Redis 连接串（必填；本地开发 host 用 localhost/127.0.0.1，Docker 内用服务名 redis）
REDIS_URL=redis://localhost:6379/0
# 商品/分类缓存 TTL（秒；可选，默认 300；<=0 时回退默认值）
PRODUCT_CACHE_TTL_SECONDS=300
# JWT_SECRET（必填，无默认值）：缺失、少于 32 字节或命中已知弱值时后端拒绝启动。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Access Token 有效期（分钟；可选，默认 15）
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh Token 有效期（天；可选，默认 7）
REFRESH_TOKEN_EXPIRE_DAYS=7
# 登录限流（可选，固定窗口；0 或负数关闭对应维度）
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_PER_IP=30
LOGIN_RATE_LIMIT_MAX_PER_USER=10
