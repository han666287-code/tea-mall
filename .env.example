# TeaMall Docker 部署环境变量示例
# 使用前复制为 .env：Linux/macOS 用 cp .env.example .env；Windows 用 Copy-Item .env.example .env
# 然后生成随机 JWT_SECRET，并按需修改 MySQL 口令（生产环境务必使用强随机口令）。
# 注意：修改 MYSQL_PASSWORD 后需同步 DATABASE_URL 中的密码。
# ---- MySQL（宿主机端口默认 3307，避免与本机 MySQL 3306 冲突）----
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_PORT=3307

# ---- Redis ----
REDIS_PORT=6379

# ---- 服务端口 ----
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ---- 后端连接串（host 使用 compose 服务名，容器网络内访问）----
# 注意：密码必须与 MYSQL_PASSWORD 一致
DATABASE_URL=mysql+pymysql://tea_mall:CHANGE_ME_DB_PASSWORD@mysql:3306/tea_mall?charset=utf8mb4
REDIS_URL=redis://redis:6379/0

# ---- JWT（必填）----
# 缺失、少于 32 字节或命中已知弱值（dev-only/change-me 等）时，后端会拒绝启动。
# 生成方式（任选其一）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRE_DAYS=7
