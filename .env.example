# TeaMall Docker 部署环境变量示例
# 使用前复制为 .env：Linux/macOS 用 cp .env.example .env；Windows 用 Copy-Item .env.example .env
# 然后生成随机 JWT_SECRET，并按需修改 MySQL 口令（生产环境务必使用强随机口令）。
# 注意：修改 MYSQL_PASSWORD 后需同步 DATABASE_URL 中的密码。
#
# 变量说明格式：作用（是否必填，默认值 / 示例值）
# Docker 部署：后端连接串 host 使用 compose 服务名 mysql / redis（容器网络内访问）；
# 本地开发：host 使用 localhost / 127.0.0.1（见 backend/.env.example）。

# ---- MySQL（必填；示例值为 CHANGE_ME_*，复制后请替换为强随机口令）----
# 宿主机映射端口（可选，默认 3307，避免与本机 MySQL 3306 冲突）
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# 应用账号密码，必须与下方 DATABASE_URL 中的密码一致
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_PORT=3307

# ---- Redis（必填）----
# 宿主机映射端口（可选，默认 6379；当前项目 Redis 无密码，连接串不带口令）
REDIS_PORT=6379
# 商品/分类缓存 TTL（秒；可选，默认 300；<=0 时回退默认值）
PRODUCT_CACHE_TTL_SECONDS=300

# ---- 服务端口（可选，默认如下）----
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ---- 后端连接串（必填；Docker 内 host 为 compose 服务名 mysql / redis）----
# 注意：密码必须与 MYSQL_PASSWORD 一致
DATABASE_URL=mysql+pymysql://tea_mall:CHANGE_ME_DB_PASSWORD@mysql:3306/tea_mall?charset=utf8mb4
REDIS_URL=redis://redis:6379/0

# ---- JWT（必填，无默认值）----
# JWT_SECRET 缺失、少于 32 字节或命中已知弱值（dev-only/change-me 等）时，后端会拒绝启动。
# 生成方式（任选其一）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
JWT_SECRET=
# Access Token 有效期（分钟；可选，默认 15）
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh Token 有效期（天；可选，默认 7）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 登录限流（可选，固定窗口；IP 30 次、用户名 10 次 / 300 秒，0 或负数关闭对应维度）----
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_PER_IP=30
LOGIN_RATE_LIMIT_MAX_PER_USER=10

# ---- 管理员初始化（可选，仅 seed.py 使用，不影响 docker compose up 启动）----
# ADMIN_USERNAME：管理员用户名（可选，默认 admin）
# ADMIN_PASSWORD：管理员密码（运行 seed.py 时必填；至少 12 位，禁止 admin123 等弱密码）
# 用法（Docker）：
#   docker compose exec -e ADMIN_USERNAME=admin -e ADMIN_PASSWORD='<强密码>' backend python seed.py
# 用法（本地开发）：
#   $env:ADMIN_PASSWORD='<强密码>'   # 可选：$env:ADMIN_USERNAME='admin'
#   python seed.py
# 留空时 seed.py 会明确报错退出，不会影响项目启动。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
