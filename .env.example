# TeaMall Docker 部署环境变量示例
# 使用前复制为 .env：Linux/macOS 用 cp .env.example .env，Windows 用 Copy-Item .env.example .env
# 修改密码后需同时同步 MYSQL_PASSWORD 与 DATABASE_URL 中的密码。

# ---- MySQL（宿主机端口默认 3307，避免与本机 MySQL 3306 冲突）----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=tea_mall_dev
MYSQL_PORT=3307

# ---- Redis ----
REDIS_PORT=6379

# ---- 服务端口 ----
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ---- 后端连接串（host 使用 compose 服务名，容器网络内访问）----
DATABASE_URL=mysql+pymysql://tea_mall:tea_mall_dev@mysql:3306/tea_mall?charset=utf8mb4
REDIS_URL=redis://redis:6379/0

# ---- JWT ----
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
JWT_EXPIRE_DAYS=7
